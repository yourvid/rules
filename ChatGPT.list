# ChatGPT / OpenAI 专用规则集
# 格式: classical | 更新: 2026-11
# 原则: 所有 OpenAI 自有及强相关域名/IP 统一走独立出口，避免出口分裂触发风控

# ========== 核心自有域名 ==========
DOMAIN-SUFFIX,openai.com
DOMAIN-SUFFIX,chatgpt.com
DOMAIN-SUFFIX,chat.com
DOMAIN-SUFFIX,sora.com
DOMAIN-SUFFIX,oaistatic.com
DOMAIN-SUFFIX,oaistatsig.com
DOMAIN-SUFFIX,oaiusercontent.com
DOMAIN-SUFFIX,openaiusercontent.com
DOMAIN-SUFFIX,crixet.com
DOMAIN-KEYWORD,openai

# ========== CDN / 后端 / 实时通道 ==========
DOMAIN-SUFFIX,openai.com.cdn.cloudflare.net
DOMAIN-SUFFIX,openaicom.imgix.net
DOMAIN-SUFFIX,openaiapi-site.azureedge.net
DOMAIN-SUFFIX,production-openaicom-storage.azureedge.net
DOMAIN-SUFFIX,openaicomproductionae4b.blob.core.windows.net
DOMAIN-SUFFIX,openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net
DOMAIN-SUFFIX,webpubsub.azure.com

# ========== 人机验证 (Arkose) ==========
DOMAIN,client-api.arkoselabs.com
DOMAIN,openai-api.arkoselabs.com

# ========== 语音 / 实时通信 (LiveKit) ==========
DOMAIN-SUFFIX,chatgpt.livekit.cloud
DOMAIN-SUFFIX,host.livekit.cloud
DOMAIN-SUFFIX,turn.livekit.cloud

# ========== 登录与身份相关 ==========
DOMAIN-SUFFIX,workos.com
DOMAIN-SUFFIX,workoscdn.com
DOMAIN-SUFFIX,auth0.com

# ========== 第三方依赖（OpenAI 实际请求路径中出现） ==========
DOMAIN-SUFFIX,algolia.net
DOMAIN-SUFFIX,api.statsig.com
DOMAIN-SUFFIX,ct.sendgrid.net
DOMAIN,browser-intake-datadoghq.com
DOMAIN,rum.browser-intake-datadoghq.com

